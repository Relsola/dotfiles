CompileFlags:
  Add:
    - -std=gnu++23
    - -fno-exceptions
    - -fno-rtti
    - -Wall

Index:
  Background: Build

InlayHints:
  Enabled: No

Diagnostics:
  UnusedIncludes: None

Completion:
  HeaderInsertion: Never

---
If:
  PathMatch: .*/(third_party|lib)/.*
Index:
  Background: Skip
Diagnostics:
  Suppress: "*"
