CompileFlags:
  Add:
    - -xc++
    - -std=gnu++14
    - -fno-exceptions
    - -fno-rtti
    - -Wall
    - -Wextra
    - -Wshadow

Index:
  Background: Build

InlayHints:
  Enabled: No

Diagnostics:
  Suppress:
    - unused-includes

Completion
  HeaderInsertion: Never

---
If:
  PathMatch: [data/.*]

Index:
  Background: Skip

Diagnostics:
  Suppress: '*'
